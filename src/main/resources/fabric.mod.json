{
  "schemaVersion": 1,
  "id": "tarkovcraft",
  "version": "${version}",
  "name": "TarkovCraft",
  "description": "Tarkov-inspired tactical inventory, grid storage, equipment, corpse looting, and two-stage search mechanics for Minecraft 1.20.1 Fabric.",
  "authors": [
    "TarkovCraft Team"
  ],
  "license": "MIT",
  "environment": "*",
  "languageAdapters": {
    "tarkovcraft_voicechat": "com.tarkovcraft.compat.voicechat.VoicechatAdapter"
  },
  "entrypoints": {
    "voicechat": [
      {
        "adapter": "tarkovcraft_voicechat",
        "value": "tarkovcraft"
      }
    ],
    "main": [
      "com.tarkovcraft.TarkovCraftMod"
    ],
    "client": [
      "com.tarkovcraft.client.TarkovCraftClient"
    ],
    "modmenu": [
      "com.tarkovcraft.client.compat.TarkovModMenuIntegration"
    ],
    "emi": [
      "com.tarkovcraft.client.compat.TarkovEmiPlugin"
    ]
  },
  "mixins": [
    "tarkovcraft.mixins.json"
  ],
  "suggests": {
    "voicechat": "*",
    "vc-audio-distance": "*"
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
